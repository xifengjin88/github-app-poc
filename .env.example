# ---- GitHub App (multi-tenant) credentials ----
# From your GitHub App settings page (Settings > Developer settings > GitHub Apps).
# In multi-tenant mode the App can be installed on any org/repo; the installation
# is read from each webhook payload, so NO installation ID is configured here.
GITHUB_APP_ID=123456

# The PEM private key you generated for the app.
# Paste it as a single line with literal \n between lines, e.g.
#   GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
# (The app replaces \n with real newlines at startup.)
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# The webhook secret you set when creating the GitHub App.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string

# Redis connection URL for persistent multi-tenant state (repo -> installation map,
# subscriptions, distributed locks). Leave unset for local dev to use in-memory state.
# REDIS_URL=redis://localhost:6379

# The bot's @-mention handle. For a GitHub App this is the app slug.
# Users mention it as "@your-app-slug". Set this to that slug.
GITHUB_BOT_USERNAME=your-app-slug

# ---- AI model ----
# Anthropic API key for the review LLM.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the review model (default: claude-sonnet-4-6).
# REVIEW_MODEL=claude-sonnet-4-6

# ---- Archera cost grounding (optional, Phase 1) ----
# When set, the review model looks up REAL on-demand prices and reservation
# savings via Archera's MCP server (https://mcp.archera.ai/mcp) instead of
# estimating. Leave unset to get an (ungrounded) estimate review.
# The token is an Archera OAuth bearer token; its default org scopes the data.
# ARCHERA_MCP_TOKEN=
# ARCHERA_MCP_URL=https://mcp.archera.ai/mcp

# ---- Server ----
# Local port the webhook server listens on.
PORT=3000
